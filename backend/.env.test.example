# Osobna baza PostgreSQL tylko do testów (nie używaj produkcyjnej / dev bez potrzeby).
# Skopiuj: cp .env.test.example .env.test
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/myjnia_pb_test?schema=public"
JWT_SECRET="test-jwt-secret-minimum-32-characters-long"
NODE_ENV=test
FRONTEND_URL="http://localhost:5173"

# Neon / inna chmura: jeśli nazwa bazy NIE zawiera "_test" (np. .../neondb?sslmode=...),
# dodaj poniższą linię — tylko gdy to OSOBNA baza/branch wyłącznie pod testy:
# RUN_API_TESTS=true
